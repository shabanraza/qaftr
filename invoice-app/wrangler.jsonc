{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Signed and cleared ZATCA invoice XML (kept 6+ years under the VAT law).
  "r2_buckets": [{ "binding": "ZATCA_XML", "bucket_name": "qaftr-zatca-xml" }],
  // Resend signed invoices ZATCA has not accepted yet (src/server.ts scheduled handler).
  // Hourly: each run wakes the database, and Neon only suspends it after 5 idle
  // minutes, so a 5-minute schedule kept it running all month.
  "triggers": { "crons": ["0 * * * *"] }
}
